# AWS Configuration
AWS_REGION=ap-south-1

# DynamoDB Table Names
DYNAMODB_USERS_TABLE=finops-saas-dev-users
DYNAMODB_COURSES_TABLE=finops-saas-dev-courses
DYNAMODB_TIERS_TABLE=finops-saas-dev-course-tiers
DYNAMODB_ENROLLMENTS_TABLE=finops-saas-dev-enrollments
DYNAMODB_LESSONS_TABLE=finops-saas-dev-lessons
DYNAMODB_PROGRESS_TABLE=finops-saas-dev-progress
DYNAMODB_LEADS_TABLE=finops-saas-dev-service-leads
DYNAMODB_MENTORSHIP_TABLE=finops-saas-dev-mentorship-sessions
DYNAMODB_MODULES_TABLE=finops-saas-dev-modules

# Cognito
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-client-id

# S3 Buckets
S3_VIDEO_BUCKET=finops-saas-dev-videos
S3_DOCUMENTS_BUCKET=finops-saas-dev-documents

# Razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-secret

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# SES
SES_SENDER_EMAIL=noreply@yourdomain.com
